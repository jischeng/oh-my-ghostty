{
  "id": "droid",
  "displayName": "Droid",
  "command": "droid",
  "iconAsset": "AgentDroid",
  "opticalScale": 0.9,
  "process": {
    "executables": [
      "droid"
    ],
    "runtimeMarkers": [
      "droid"
    ]
  },
  "resume": {
    "resumeArguments": []
  },
  "hook": {
    "kind": "json",
    "dialect": "nested",
    "path": "~/.factory/settings.json",
    "events": [
      {
        "name": "SessionStart",
        "state": "idle"
      },
      {
        "name": "UserPromptSubmit",
        "state": "working"
      },
      {
        "name": "PreToolUse",
        "state": "working"
      },
      {
        "name": "PostToolUse",
        "state": "working"
      },
      {
        "name": "Stop",
        "state": "done"
      }
    ]
  }
}
