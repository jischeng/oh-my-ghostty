{
  "id": "claude",
  "displayName": "Claude Code",
  "command": "claude",
  "iconAsset": "AgentClaude",
  "process": {
    "executables": ["claude"],
    "runtimeMarkers": ["claude", "claude-code"]
  },
  "resume": {
    "createArguments": ["--session-id", "{id}"],
    "resumeArguments": ["--resume", "{id}"],
    "store": {
      "root": "~/.claude/projects",
      "entryPattern": "{id}.jsonl"
    }
  },
  "hook": {
    "kind": "json",
    "path": "~/.claude/settings.json",
    "conversationField": "session_id",
    "transcriptField": "transcript_path",
    "toolField": "tool_name",
    "events": [
      {"name": "SessionStart", "state": "idle"},
      {"name": "UserPromptSubmit", "state": "working"},
      {"name": "PreToolUse", "state": "working"},
      {"name": "PostToolUse", "state": "working"},
      {"name": "PermissionRequest", "state": "needsAttention"},
      {"name": "Stop", "state": "done"},
      {"name": "SessionEnd"},
      {"name": "Notification", "state": "needsAttention", "matcher": "permission_prompt"}
    ]
  }
}
