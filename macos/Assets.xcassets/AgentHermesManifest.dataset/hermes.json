{
  "id": "hermes",
  "displayName": "Hermes",
  "command": "hermes",
  "iconAsset": "AgentHermesGlyph",
  "opticalScale": 0.9,
  "process": {
    "executables": [
      "hermes"
    ],
    "runtimeMarkers": [
      "hermes"
    ]
  },
  "resume": {
    "resumeArguments": [
      "--resume",
      "{id}"
    ]
  },
  "hook": {
    "kind": "yaml",
    "path": "~/.hermes/config.yaml",
    "conversationField": "session_id",
    "events": [
      {
        "name": "on_session_start",
        "state": "idle"
      },
      {
        "name": "pre_llm_call",
        "state": "working"
      },
      {
        "name": "post_llm_call",
        "state": "done"
      },
      {
        "name": "on_session_end"
      }
    ]
  }
}
