{
  "id": "claude",
  "displayName": "Claude Code",
  "command": "claude",
  "iconAsset": "AgentClaude",
  "opticalScale": 0.9,
  "process": {
    "executables": [
      "claude"
    ],
    "runtimeMarkers": [
      "claude",
      "claude-code"
    ]
  },
  "resume": {
    "createArguments": [
      "--session-id",
      "{id}"
    ],
    "resumeArguments": [
      "--resume",
      "{id}"
    ],
    "forkArguments": [
      "--resume",
      "{id}",
      "--fork-session"
    ],
    "store": {
      "root": "~/.claude/projects",
      "entryPattern": "{id}.jsonl"
    }
  },
  "hook": {
    "kind": "json",
    "path": "~/.claude/settings.json",
    "conversationField": "session_id",
    "transcriptField": "transcript_path",
    "toolField": "tool_name",
    "events": [
      {
        "name": "SessionStart",
        "state": "idle"
      },
      {
        "name": "UserPromptSubmit",
        "state": "working"
      },
      {
        "name": "PreToolUse",
        "state": "working"
      },
      {
        "name": "PreToolUse",
        "state": "needsAttention",
        "matcher": "AskUserQuestion|ExitPlanMode"
      },
      {
        "name": "PostToolUse",
        "state": "working"
      },
      {
        "name": "PostToolUseFailure",
        "state": "working",
        "matcher": "AskUserQuestion|ExitPlanMode"
      },
      {
        "name": "PermissionRequest",
        "state": "needsAttention"
      },
      {
        "name": "SubagentStart",
        "state": "working"
      },
      {
        "name": "SubagentStop"
      },
      {
        "name": "Stop",
        "state": "done"
      },
      {
        "name": "StopFailure",
        "state": "error"
      },
      {
        "name": "SessionEnd"
      },
      {
        "name": "Notification",
        "state": "needsAttention",
        "matcher": "permission_prompt"
      }
    ]
  },
  "titleStatus": {
    "working": [
      "^[⠀-⣿◐-◓] "
    ]
  }
}
